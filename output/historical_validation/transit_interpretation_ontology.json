  "interpretation_rules": {
    "composition": "planet themes + natal-target functions + aspect operation + measured modifiers",
    "eligible_outcome_policy": "intersection of planet and natal-target eligible outcomes; empty intersections remain exploratory rather than broadened post hoc",
